{
  "name": "perfectnails",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "next dev --turbo",
    "dev:webpack": "next dev",
    "dev:clean": "npm run clean && next dev --turbo",
    "build": "next build",
    "start": "next start",
    "db:schema": "bash scripts/apply-db-schema.sh",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/nailsbyni/002_seed.sql",
    "db:verify": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/nailsbyni/verify.sql",
    "cms:inspect": "tsx scripts/inspect-cms-site.ts",
    "cms:strip-s3-site": "tsx scripts/strip-s3-site.ts",
    "db:import-bookings": "tsx scripts/import-bookings-from-json.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "next": "14.2.35",
    "pg": "^8.21.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sharp": "^0.34.5",
    "twilio": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "autoprefixer": "10.4.14",
    "postcss": "8.4.21",
    "tailwindcss": "3.4.1",
    "tsx": "^4.22.4",
    "typescript": "5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huynhloc0410/perfectnails.git"
  }
}
